# ─────────────────────────────────────────────────────────────
# MykeSystems API — variables de entorno
# Copiar como .env y completar. NUNCA subir el .env a Git ni al sitio público.
# ─────────────────────────────────────────────────────────────

APP_NAME="MykeSystems API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Hash de contraseñas. Producción: argon2id (verificar que PHP tenga soporte Argon2:
#   php -r "var_dump(defined('PASSWORD_ARGON2ID'));")
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos (producción: MariaDB, usuario exclusivo, solo 127.0.0.1)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mykesystems
DB_USERNAME=mykesystems
DB_PASSWORD=

# Sesión del panel (admin.mykesystems.com)
# - SESSION_DOMAIN=null → cookie solo del host del panel, nunca de mykesystems.com
# - Producción: SESSION_COOKIE=__Host-myke_admin y SESSION_SECURE_COOKIE=true
#   (el prefijo __Host- exige HTTPS, Path=/ y sin Domain; no funciona en http://localhost)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=myke_admin_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
# Duración máxima de una sesión aunque haya actividad (horas)
ADMIN_SESSION_ABSOLUTE_HOURS=12

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correo saliente (notificaciones internas). Local: "log" escribe el correo en storage/logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="solicitudes@mykesystems.com"
MAIL_FROM_NAME="MykeSystems"

# ── MykeSystems ──────────────────────────────────────────────
# Orígenes permitidos para el formulario público (separados por coma)
# Producción: https://mykesystems.com,https://www.mykesystems.com
PUBLIC_ALLOWED_ORIGINS=http://localhost:3000

# Panel administrativo
# Producción: ADMIN_DOMAIN=admin.mykesystems.com · SANCTUM_STATEFUL_DOMAINS=admin.mykesystems.com
# ⚠️ Nunca incluir mykesystems.com en SANCTUM_STATEFUL_DOMAINS.
# Local: deja ADMIN_DOMAIN vacío (sin restricción de dominio) y usa el puerto del panel (Vite).
ADMIN_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# API de solicitudes del panel (Fase C)
# Zona horaria con la que se interpretan los filtros de fecha (las fechas se devuelven en UTC)
ADMIN_TIMEZONE=America/Tegucigalpa
ADMIN_API_READS_PER_MINUTE=120
ADMIN_API_WRITES_PER_MINUTE=30

# Correo interno que recibe el aviso de nuevas solicitudes (nunca se muestra al visitante)
ADMIN_NOTIFY_EMAIL=solicitudes@mykesystems.com
ADMIN_PANEL_URL=http://localhost:5173

# Límites del formulario público
LEADS_LIMIT_PER_MINUTE=3
LEADS_LIMIT_PER_HOUR=5
LEADS_LIMIT_GLOBAL_PER_DAY=200
ANTISPAM_MIN_FILL_SECONDS=3
